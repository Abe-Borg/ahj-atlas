{
  "name": "ahj-atlas",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Local, evidence-led AHJ research for engineers and architects.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron desktop/main.mjs",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "test:desktop:window": "node tests/desktop-window-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check desktop/main.mjs && node --check desktop/lifecycle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@napi-rs/canvas": "1.0.9",
    "exceljs": "4.4.0",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "puppeteer-core": "25.12.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
